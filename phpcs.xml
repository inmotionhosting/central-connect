<?xml version="1.0"?>
<ruleset name="Central-Connect">
	<description>Central Connect coding standards: WordPress Coding Standards plus PHPCompatibilityWP for PHP 7.4 and newer.</description>

	<file>.</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="5.0"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="central-connect"/>
			</property>
		</properties>
	</rule>

	<!--
		Baseline: the src/ tree is PSR-4 style (one StudlyCaps class per file,
		loaded by autoload.php) and its camelCase methods and properties are part
		of the REST controllers and filters other code calls. Renaming them would
		break callers, so these naming sniffs are disabled rather than "fixed".
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/src/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>

	<!-- Legacy file names loaded by path from other files and older installs. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/includes/config/config.*.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/includes/class-central-connect-upgrader.php</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!--
		PHPUnit tests build fixtures on disk, encode test tokens and declare
		small helper classes next to the test case that uses them.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.ShortNotCapital">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<exclude-pattern>*/.cursor/*</exclude-pattern>
	<exclude-pattern>*/.git/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/ci/testdata/*</exclude-pattern>
</ruleset>
